rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /siteSettings/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /homeSections/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /aboutCards/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /aboutEvents/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /services/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /aiMenuItems/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /clients/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /directors/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || true);
    }
    match /subscribers/{subId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
