{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "database": "default",
    "location": "asia-south2",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"\" run lint",
        "npm --prefix \"\" run build"
      ],
      "source": "functions"
    },
    {
      "source": "backend",
      "codebase": "trinayai",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"\" run lint",
        "npm --prefix \"\" run build"
      ],
      "source": "backend"
    }
  ],
  "apphosting": [
    {
      "backendId": "trinay-apps",
      "rootDir": "trinayai-web",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions",
        "backend"
      ]
    }
  ],
  "hosting": {
    "public": "trinayai-web/dist/trinayai-web/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
