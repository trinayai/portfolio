{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "database": "appdata",
    "location": "asia-south2",
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix functions run build"
      ]
    },
    {
      "source": "backend",
      "codebase": "trinayai",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix backend run build"
      ]
    }
  ],
  "apphosting": [
    {
      "backendId": "trinay-apps",
      "rootDir": "trinayai-web",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions",
        "backend"
      ]
    },
    {
      "backendId": "trinayai-admin",
      "rootDir": "trinayai-admin",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions",
        "backend"
      ]
    }
  ],
  "hosting": [
    {
      "site": "trinay-ai",
      "public": "trinayai-web/dist/trinayai-web/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "trinay-ai-admin",
      "public": "trinayai-admin/dist/trinayai-admin/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
